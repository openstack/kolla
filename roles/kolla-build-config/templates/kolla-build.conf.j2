{# Generate requested sections and options #}

{% for section_name, section in kolla_build_config.items() %}
[{{ section_name }}]
{% for option_name, option in section.items() %}
{{ option_name }} = {{ option }}
{% endfor %}
{% endfor %}

{# Generate a section for every build source Zuul has a checkout for,
   whether it's a required-project or a Depends-On. #}

{% for canonical_name, project in zuul['projects'].items() %}
{% if project.name in kolla_build_sources %}
{% set source_names = kolla_build_sources[project.name] %}
{% if source_names is string %}
[{{ source_names }}]
type = local
location = {{ ansible_env.PWD ~ '/' ~ project.src_dir }}
{% else %}
{% for source_name in source_names %}
[{{ source_name }}]
type = local
location = {{ ansible_env.PWD ~ '/' ~ project.src_dir }}
{% endfor %}
{% endif %}
{% endif %}
{% endfor %}
